PORT=4000
JWT_SECRET=your_jwt_secret_key_here
FABRIC_ENABLED=true

ISSUE_STRICT=false
VERIFY_STRICT=false

REQUIRE_DB=true
DB_ENABLED=true     
IPFS_ENABLED=true 

# PostgreSQL Configuration (Local Development)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=chainnesa_db
DB_USER=postgres
DB_PASSWORD=your_local_db_password

# Active Database Connection Prisma reads (Default: Local)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5433/chainnesa_db?schema=public&connect_timeout=60"
DIRECT_URL="postgresql://postgres:password@127.0.0.1:5433/chainnesa_db?schema=public&connect_timeout=60"

# Supabase Cloud Database Connection (Used for Vercel / Remote Sync)
SUPABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres"

# Legacy / Fallback
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=chainnesa_db 
PGUSER=postgres
PGPASSWORD=your_local_db_password

# IPFS (Kubo on host / docker)
IPFS_API=http://127.0.0.1:5001
IPFS_GATEWAY=http://127.0.0.1:8082
IPFS_MFS_PREFIX=/certs

# Fabric CLI context
FABRIC_BIN=/absolute/path/to/fabric-samples/bin
FABRIC_CFG=/absolute/path/to/fabric-samples/config
CHANNEL=chainnesa
CC_NAME=basic
ORDERER_CA=/absolute/path/to/.../tlsca.example.com-cert.pem
PEER0_ORG1_CA=/absolute/path/to/.../tlsca.org1.example.com-cert.pem
PEER0_ORG2_CA=/absolute/path/to/.../tlsca.org2.example.com-cert.pem

# Fabric Connection Configuration
FABRIC_CONN_PROFILE=./fabric-network/connection-org1.json
FABRIC_CHANNEL=chainnesa
FABRIC_CHAINCODE=basic
FABRIC_MSPID=Org1MSP
FABRIC_IDENTITY_LABEL=admin

# Fabric Discovery
FABRIC_DISCOVERY=true
FABRIC_ASLOCALHOST=true

# Chaincode Functions
FABRIC_FUNC_ISSUE=IssueCertificate
FABRIC_FUNC_READ=ReadCertificate
FABRIC_FUNC_LIST=GetAllCertificates

CLIENT_URL=http://localhost:3000

# Supabase Storage Integration
SUPABASE_API_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Pinata API Credentials for Dual Upload 
PINATA_JWT="your_pinata_jwt_token_here"
