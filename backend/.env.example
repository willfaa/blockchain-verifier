# ==========================================
# SERVER & SECURITY
# ==========================================
PORT=4000
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:3000


# ==========================================
# FEATURE FLAGS & BLOCKCHAIN (FABRIC)
# ==========================================
# Set FABRIC_ENABLED=false jika tidak menjalankan Hyperledger Fabric lokal/WSL
FABRIC_ENABLED=false
FABRIC_CHANNEL=chainnesa

# ==========================================
# DATABASE (PRISMA & SUPABASE POSTGRES)
# ==========================================
# Supabase Pooler URL (Transaction Mode / Session Mode)
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres"
# Direct connection URL (bisa menggunakan direct Supabase host db.yourprojectref.supabase.co:5432 atau postgres lokal)
DIRECT_URL="postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres"

# ==========================================
# STORAGE & IPFS (SUPABASE & PINATA)
# ==========================================
SUPABASE_API_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
PINATA_JWT="your_pinata_jwt_token_here"

# IPFS Local Node (Optional Fallback jika tidak menggunakan Pinata)
IPFS_API=http://127.0.0.1:5001
IPFS_GATEWAY=http://127.0.0.1:8082

