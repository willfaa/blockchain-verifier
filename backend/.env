PORT=4000
FABRIC_ENABLED=true

ISSUE_STRICT=true

VERIFY_STRICT=true

REQUIRE_DB=true
DB_ENABLED=true     
IPFS_ENABLED=true 

# PostgreSQL Configuration (Local Development)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=chainnesa_db
DB_USER=postgres
DB_PASSWORD=willfaa

# Active Database Connection Prisma reads (Default: Local)
DATABASE_URL="postgresql://postgres:willfaa@127.0.0.1:5433/chainnesa_db?schema=public&connect_timeout=60"
DIRECT_URL="postgresql://postgres:willfaa@127.0.0.1:5433/chainnesa_db?schema=public&connect_timeout=60"

# Supabase Cloud Database Connection (Used for Vercel / Remote Sync)
# Note: Space in password "Blockchain Verifier" is encoded as "Blockchain%20Verifier"
SUPABASE_URL="postgresql://postgres.pitbddduxxntkhawzxrr:Blockchain%20Verifier@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Legacy / Fallback
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=chainnesa_db 
PGUSER=postgres
PGPASSWORD=willfaa

# IPFS (Kubo on host / docker)
IPFS_API=http://127.0.0.1:5001
IPFS_GATEWAY=http://127.0.0.1:8081
IPFS_MFS_PREFIX=/certs

# Fabric CLI context
FABRIC_BIN=/absolute/path/to/fabric-samples/bin
FABRIC_CFG=/absolute/path/to/fabric-samples/config
CHANNEL=mychannel
CC_NAME=basic
ORDERER_CA=/absolute/path/to/.../tlsca.example.com-cert.pem
PEER0_ORG1_CA=/absolute/path/to/.../tlsca.org1.example.com-cert.pem
PEER0_ORG2_CA=/absolute/path/to/.../tlsca.org2.example.com-cert.pem

# koneksi Fabric
FABRIC_CONN_PROFILE=./fabric-network/connection-org1.json
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=basic
FABRIC_MSPID=Org1MSP
FABRIC_IDENTITY_LABEL=admin

# discovery
FABRIC_DISCOVERY=true
FABRIC_ASLOCALHOST=true

# fungsi chaincode
FABRIC_FUNC_ISSUE=IssueCertificate
FABRIC_FUNC_READ=ReadCertificate
FABRIC_FUNC_LIST=GetAllCertificates

#JWT
JWT_SECRET=key_lms

# alternatif domain
CLIENT_URL=http://192.168.1.8:3000