generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- USER MANAGEMENT ---
// Single Source of Truth untuk semua pengguna
model User {
  id       String  @id @default(uuid())
  email    String  @unique // The generated @chainnesa.com email
  personalEmail String? @unique // The original Gmail/Yahoo input
  password String
  name     String
  role     String  // "admin", "teacher", "student"
  isVerified Boolean @default(false) // Verified by Admin (Teachers need this)
  isActive   Boolean @default(true)  // For Banning users

  // Identitas Khusus (Nullable)
  bio      String? @db.Text
  avatar   String? // Store path to uploaded avatar
  nim      String? @unique // Diisi jika Student
  nip      String? @unique // Diisi jika Teacher
   
  // Data Akademik (Nullable - Bisa dipakai Student & Teacher)
  majority String? // Jurusan / Departemen
  studyProgram  String? // Prodi / Bidang Keahlian

  createdAt DateTime @default(now()) // Best practice: audit trail
  updatedAt DateTime @updatedAt

  // --- RELASI ---
  // 1. Course yang dibuat oleh user ini (sebagai Teacher)
  createdCourses Course[]      @relation("CreatedCourses")
  
  // 2. Course yang diikuti user ini (sebagai Student)
  enrollments    Enrollment[]  
  
  // 3. Sertifikat yang dimiliki user ini
  certificates   Certificate[] 

  // 4. Hasil ujian user ini
  examResults    ExamResult[] 

  @@map("users")
}

// --- LMS CORE ---
model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  thumbnail   String?  
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Metadata
  category       String? 
  studyProgram   String? 
  targetAudience String?
  allowedPrograms String[] @default([])

  // Relasi ke Pembuat (Teacher)
  // Tetap pakai 'teacherId' sesuai request, mengacu ke User.id
  teacherId   String
  teacher     User     @relation("CreatedCourses", fields: [teacherId], references: [id])
   
  // Relasi Konten
  chapters    Chapter[]   // New Hierarchy
  exams       Exam[]    
  enrollments Enrollment[]
  certificates Certificate[] 

  @@map("courses")
}

// New Model: Chapter (Section)
model Chapter {
  id          String   @id @default(uuid())
  title       String
  order       Int      // Urutan Chapter
  isPublished Boolean  @default(true)
  
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  lessons     Lesson[]
  
  @@map("chapters")
}

// Model Video Offline
model Lesson {
  id        String   @id @default(uuid())
  title     String
  content   String?  
  videoPath String?  // Path video lokal (/uploads/videos/...)
  duration  Int?     
  order     Int      
  isPublished Boolean @default(false) // Add publish status for granular control
  isFreePreview Boolean @default(false) // Allow free preview for non-enrolled students
   
  // Hierarchy Change: Lesson belongs to Chapter, not Course directly
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

// Model Pendaftaran Siswa ke Kursus
model Enrollment {
  id        String   @id @default(uuid())
  
  // Relasi ke Siswa (User)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relasi ke Kursus
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    String   @default("Pending") 
  progress    Int      @default(0)
  isCompleted Boolean  @default(false)

  enrolledAt  DateTime @default(now())
  completedAt DateTime? // Added for certificate tracking
  certificateId String? // Added for certificate tracking

  // Mencegah satu user enroll course yang sama 2x
  @@unique([userId, courseId])
  @@map("enrollments")
}

// --- EXAM SYSTEM ---
model Exam {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  durationMinutes Int   @default(60)
  passingScore Int      @default(70)
  isEnabled    Boolean  @default(false) // Renamed from isPublished
  strictMode   Boolean  @default(false)
  isPractice   Boolean  @default(false)
  
  courseId     String   @unique // Enforce 1:1 Relation
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  questions    Question[]
  results      ExamResult[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("exams")
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY // Prepared for future
}

model Question {
  id        String       @id @default(uuid())
  text      String       @db.Text
  type      QuestionType @default(MULTIPLE_CHOICE)
  isActive  Boolean      @default(false) // Toggle for Question Bank
  position  Int          @default(0)
  points    Int          @default(10)
  
  examId    String
  exam      Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  options   Option[]
  userAnswers UserAnswer[]

  @@map("questions")
}

model Option {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]

  @@map("options")
}

model ExamResult {
  id        String   @id @default(uuid())
  score     Float
  status    String   // "PASSED" | "FAILED"
  
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  startedAt  DateTime @default(now())
  finishedAt DateTime @default(now())

  answers    UserAnswer[]

  @@map("exam_results")
}

model UserAnswer {
  id           String     @id @default(uuid())
  
  examResultId String
  examResult   ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  
  optionId     String
  option       Option     @relation(fields: [optionId], references: [id])

  @@map("user_answers")
}

// --- CERTIFICATE ---
model Certificate {
  id          String   @id @default(uuid())
  certId      String   @unique 
  
  // Data Snapshot (Disimpan sebagai string agar historis tetap aman meski user berubah nama)
  studentName String
  nim         String
  program     String
  majority    String
   
  // Relasi Opsional (Bisa null jika course dihapus/manual issue)
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])

  // Relasi ke Pemilik (Siswa)
  userId      String    
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  issuedAt    String   // ISO Date String
  
  // Blockchain Data
  cid         String   
  hash        String   
  status      String   @default("ISSUED") // "ISSUED", "REVOKED"

  @@map("certificates")
}